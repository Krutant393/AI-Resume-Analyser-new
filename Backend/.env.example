# MongoDB Atlas or Local MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/airesumeanalyser?retryWrites=true&w=majority

# JWT secret key for signing authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# OpenRouter AI API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# AI Model for resume analysis (defaults to openai/gpt-4o-mini if omitted)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Server port (defaults to 3000 if omitted)
PORT=3000
